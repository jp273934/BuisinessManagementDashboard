@model IEnumerable<WorkOrder>

@{
    ViewData["Title"] = "Work Orders";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Work Order Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            Add Work Order
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <form asp-action="Index" method="get" class="mb-4">
        <div class="row g-3">

            <div class="col-md-5">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search customer or service" />
            </div>

            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>

                    <option value="Open"
                            selected="@(ViewBag.SelectedStatus == "Open")">
                        Open
                    </option>

                    <option value="In Progress"
                            selected="@(ViewBag.SelectedStatus == "In Progress")">
                        In Progress
                    </option>

                    <option value="Completed"
                            selected="@(ViewBag.SelectedStatus == "Completed")">
                        Completed
                    </option>
                </select>
            </div>

            <div class="col-md-3">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Filter
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </div>

        </div>
    </form>
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Service</th>
                            <th>Status</th>
                            <th>Price</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var badgeClass = order.Status switch
                            {
                                "Completed" => "bg-success",
                                "In Progress" => "bg-primary",
                                _ => "bg-warning text-dark"
                            };

                            <tr>
                                <td>@order.Customer.Name</td>
                                <td>@order.Service</td>
                                <td>
                                    <span class="badge @badgeClass">
                                        @order.Status
                                    </span>
                                </td>
                                <td>@order.Price.ToString("C")</td>
                                <td>@order.CreatedDate.ToString("MM/dd/yyyy")</td>
                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    No work orders found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @{
        int currentPage = ViewBag.CurrentPage;
        int totalPages = ViewBag.TotalPages;
        int totalOrders = ViewBag.TotalOrders;
    }

    <div class="d-flex justify-content-between
            align-items-center mt-3">

        <div class="text-muted">
            Total Work Orders: @totalOrders
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Work order pagination">
                <ul class="pagination mb-0">

                    <li class="page-item
                        @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.SelectedStatus">
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item
                                @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@ViewBag.Search"
                               asp-route-status="@ViewBag.SelectedStatus">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item
                        @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.SelectedStatus">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        }
    </div>
</div>
