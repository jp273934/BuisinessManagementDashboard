@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container- py-4">
    <h2>Business Dashboard</h2>
    <p class="text-muted mb-4">
        Overview of your business operations
    </p>


    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted">Total Customers</h6>
                    <h2 class="fw-bold text-primary">
                        @Model.TotalCustomers
                    </h2>
                    <small class="text-muted">
                        Registered customers
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted">Open Orders</h6>
                    <h2 class="fw-bold text-warning">
                        @Model.OpenOrders
                    </h2>
                    <small class="text-muted">
                        Awaiting completion
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted">Completed Orders</h6>
                    <h2 class="fw-bold text-success">
                        @Model.CompletedOrders
                    </h2>
                    <small class="text-muted">
                        Finished work orders
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted">Completed Revenue</h6>
                    <h2 class="fw-bold text-info">
                        @Model.TotalRevenue.ToString("C")
                    </h2>
                    <small class="text-muted">
                        Value of completed orders
                    </small>
                </div>
            </div>
        </div>

    </div>
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h5 class="mb-3">
                Monthly Completed Work Order Value
            </h5>

            <div style="height: 320px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Recent Work Orders</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Service</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            var badgeClass = order.Status switch
                            {
                                "Completed" => "bg-success",
                                "In Progress" => "bg-primary",
                                _ => "bg-warning text-dark"
                            };

                            <tr>
                                <td>@order.CustomerName</td>
                                <td>@order.Service</td>
                                <td>
                                    <span class="badge @badgeClass">
                                        @order.Status
                                    </span>
                                </td>
                            </tr>
                        }

                        @if (!Model.RecentOrders.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4">
                                    No work orders have been created yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>

    <script>
        const revenueLabels = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            Model.MonthlyRevenue.Select(x => x.Month)));

    const revenueValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.MonthlyRevenue.Select(x => x.Revenue)));

    const canvas = document.getElementById('revenueChart');

        new Chart(canvas, {
            type: 'bar',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Completed Work Order Value',
                    data: revenueValues,
                    backgroundColor: 'rgba(13, 110, 253, 0.65)',
                    borderColor: 'rgba(13, 110, 253, 1)',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => '$' + value.toLocaleString()
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: context =>
                                '$' + context.parsed.y.toLocaleString(
                                    'en-US',
                                    { minimumFractionDigits: 2 }
                                )
                        }
                    }
                }
            }
        });
    </script>
}
